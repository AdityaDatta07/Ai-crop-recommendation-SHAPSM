# ============================================================
# crop-recommendation - environment template
# Copy to .env and fill in real values. NEVER commit .env.
#   cp .env.example .env
# ============================================================

# ---------- Core ----------
APP_ENV=development            # development | staging | production
LOG_LEVEL=info                 # debug | info | warning | error

# ---------- apps/api (FastAPI) ----------
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=                # random 32+ char string, e.g. `openssl rand -hex 32`
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---------- apps/web (Next.js PWA) ----------
# NEXT_PUBLIC_* vars are exposed to the browser - put NO secrets here.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_MAP_TILE_URL=

# ---------- Result persistence ----------
# Results are stored in SQLite at data/results.db by default, so shareable
# /r/<id> links survive an API restart with no external service.
# Override only if that path is on a network share or WSL mount, where SQLite
# cannot take file locks and raises "disk I/O error".
RESULTS_DB_PATH=

# ---------- Database / Supabase ----------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=     # server-side only, bypasses RLS - keep secret
DATABASE_URL=postgresql://user:password@localhost:5432/cropdb

# ---------- services/geo (Google Earth Engine) ----------
GEE_SERVICE_ACCOUNT_EMAIL=     # e.g. gee-runner@project-id.iam.gserviceaccount.com
GEE_PROJECT_ID=                # required; the Cloud project registered with Earth Engine

# Supply the service-account key ONE of these two ways.
#
# NOTE: no trailing comments on these two lines. An empty value followed by a
# comment gets parsed as the comment text, which then shadows the other setting
# and fails with an unhelpful base64 error.
#
# Local development: path to the JSON key file.
GEE_PRIVATE_KEY_PATH=./secrets/gee-key.json
#
# Deployment: base64 of the whole JSON file, on one line. Leave EMPTY locally.
#   Windows:     certutil -encode gee-key.json tmp.b64
#   macOS/Linux: base64 -w0 gee-key.json
GEE_SERVICE_ACCOUNT_KEY_B64=

# ---------- services/ml ----------
MODEL_REGISTRY_PATH=./services/ml/artifacts
RANKER_MODEL_VERSION=v1
FORECASTER_MODEL_VERSION=v1

# ---------- LLM provider ----------
LLM_PROVIDER=anthropic         # anthropic | openai | gemini
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
LLM_MAX_TOKENS=2048

# ---------- External data APIs ----------
WEATHER_API_KEY=               # e.g. IMD / OpenWeather
SOIL_HEALTH_API_KEY=           # Soil Health Card portal
MARKET_PRICE_API_KEY=          # Agmarknet / data.gov.in
DATA_GOV_IN_API_KEY=

# ---------- Caching / jobs ----------
REDIS_URL=redis://localhost:6379/0

# ---------- Feature flags ----------
ENABLE_OFFLINE_MODE=true
ENABLE_VOICE_INPUT=false
USE_MOCK_GEO=true              # true = skip Earth Engine, serve fixtures
