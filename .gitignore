# ============================================================
# Project-specific additions (crop-recommendation)
# Appended below the standard Node template above.
# ============================================================

# ---------- Secrets / credentials ----------
.env.local
secrets/
*.pem
*.key
*-key.json
gee-*.json
service-account*.json

# ---------- Python (apps/api, services/ml, services/geo) ----------
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---------- Notebooks ----------
.ipynb_checkpoints/

# ---------- ML artifacts & large binaries ----------
services/ml/artifacts/
mlruns/
*.pkl
*.joblib
*.h5
*.onnx
*.pt
*.ckpt

# ---------- Geospatial / bulk data ----------
# Keep data/reference/ and data/seed/ committed; ignore downloads.
data/raw/
data/cache/
data/tmp/
*.tif
*.tiff
*.nc
*.zip

# ---------- Next.js PWA generated service worker ----------
# NOT ignored: apps/web/public/sw.js is hand-written source, not generated.
# The stock Next.js gitignore excludes it because next-pwa and workbox emit a
# worker at build time. Ours is committed like any other file — ignoring it
# would mean deploying with no service worker and no offline support, with
# nothing failing to say so.
apps/web/public/workbox-*.js

# ---------- Supabase local dev ----------
.supabase/
supabase/.branches/
supabase/.temp/

# ---------- Build tooling ----------
.turbo/
.vercel/

# ---------- IDE / Editor ----------
.vscode/
.idea/
*.swp

# ---------- OS files ----------
.DS_Store
Thumbs.db
desktop.ini
# ---------- Generated by apps/web (scripts/sync-fixtures.mjs) ----------
# Source of truth is data/seed/api-fixtures/, which stays committed.
apps/web/public/fixtures/

# ---------- Runtime persistence (SQLite fallback when Supabase is unset) ----------
data/results.db
data/results.db-journal
data/results.db-wal
data/results.db-shm
